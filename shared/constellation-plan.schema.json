{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mi-campo.local/schemas/constellation-plan.json",
  "title": "Mi Campo Dynamic Constellation Plan",
  "type": "object",
  "required": ["title", "type", "representatives", "protocol"],
  "properties": {
    "id": {"type":"string"},
    "title": {"type":"string","minLength":1,"maxLength":120},
    "category": {"type":"string"},
    "type": {"enum":["family","individual","decision","relationship","project","energetic","free"]},
    "intensity": {"enum":["suave","normal","profunda"]},
    "minutes": {"type":"integer","minimum":5,"maximum":60},
    "description": {"type":"string"},
    "intention": {"type":"string"},
    "representatives": {"type":"array","minItems":2,"maxItems":24,"items":{"type":"string"}},
    "protocol": {
      "type":"object",
      "properties": {
        "openingHint":{"type":"string"},
        "observationQuestions":{"type":"array"},
        "movementExperiments":{"type":"array"},
        "phrases":{"type":"array","items":{"type":"string"}},
        "phraseCategory":{"type":"string"},
        "closingPrompt":{"type":"string"},
        "closingSteps":{"type":"array"},
        "integrationActivities":{"type":"array","items":{"type":"string"}},
        "branchingRules":{"type":"array"},
        "allowIntuitiveFigures":{"type":"boolean"},
        "allowHypothesisExpansion":{"type":"boolean"}
      }
    }
  }
}
